%BANNER
%m synthetic_module
%#DEFINE FEATURE_FLAG
%#IFDEF FEATURE_FLAG
%#ENDIF
DROP PROGRAM synthetic_highlighting GO
CREATE PROGRAM synthetic_highlighting
DECLARE RESULT_VALUE = I4
SET RESULT_VALUE = cNvTiNt(1)
SET RESULT_VALUE = UaR_GeT_CoDe_DiSpLaY(1)
SET RESULT_VALUE = CuRpRoG()
SET RESULT_VALUE = ccl::RoUnD(RESULT_VALUE)
SET RESULT_VALUE = custom_function(CuRqUaL, DuMmYt)
SET RESULT_VALUE = TrUe
SELECT RESULT_VALUE
FROM DuMmYt D
UNION ALL (
  SELECT P.PERSON_ID
  FROM PERSON P
  MINUS (
    SELECT E.PERSON_ID
    FROM ENCOUNTER E
    INTERSECT (
      SELECT X.SEQ
      FROM DuMmYt X
    )
  )
)
ORDER BY RESULT_VALUE
COMMIT
ROLLBACK
END GO
