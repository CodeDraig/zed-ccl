%include synthetic_source.inc
%MODULE synthetic_module
%#DEFINE SYNTHETIC_FEATURE
SET FIRST_VALUE = $1
SET LAST_VALUE = $99
SELECT PERSON_ID = P.PERSON_ID
FROM PERSON P
WHERE P.ACTIVE_IND = 1
MINUS (
  SELECT PERSON_ID = E.PERSON_ID
  FROM ENCOUNTER E
  WHERE E.ACTIVE_IND = 0
)
ORDER BY PERSON_ID
WITH RDBUNION
COMMIT
ROLLBACK
GO
