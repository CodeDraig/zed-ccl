SELECT INTO "MINE"
  P.PERSON_ID,
  P.NAME_FULL_FORMATTED
FROM PERSON P
WHERE P.ACTIVE_IND = 1
ORDER BY P.PERSON_ID
HEAD REPORT
  ROW + 1
  CALL CENTER("Synthetic report", 0, 80)
HEAD PAGE
  COL 0 "Person"
DETAIL
  COL 0 P.PERSON_ID
  COL 20 P.NAME_FULL_FORMATTED
FOOT REPORT
  ROW + 1
  COL 0 COUNT(SEQ)
WITH FORMAT, NOCOUNTER
GO
