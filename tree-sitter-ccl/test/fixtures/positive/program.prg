DROP PROGRAM synthetic_core GO
CREATE PROGRAM synthetic_core
PROMPT "Output destination" = "MINE" WITH OUTDEV
DECLARE COUNT = I4 WITH NOCONSTANT(0), PROTECT
DECLARE LABELS[10] = C20
RECORD RESULT_RS (
1 ROWS[*]
2 PERSON_ID = F8
2 NAME = VC
) WITH PROTECT
SUBROUTINE (INCREMENT(VALUE_IN = I4(VALUE, 0)) = I4)
  RETURN(VALUE_IN + 1)
END
SET COUNT = INCREMENT(COUNT)
IF (COUNT > 0)
  CALL ECHO("positive")
ELSE
  CALL ECHO("zero")
ENDIF
FOR (INDEX = 1 TO 10 BY 1)
  SET LABELS[INDEX] = "value"
ENDFOR
WHILE (COUNT < 20)
  SET COUNT += 1
ENDWHILE
FREE RECORD RESULT_RS
END GO
