; Identifiers default to variables. More specific patterns below override this.
(identifier) @variable

; Complete modern Discern Explorer reserved-variable index. The documentation
; repeats CURNETDOMAIN where its description names CURNETDOMAINID; both names
; are intentionally recognized. Function and table captures below take final
; precedence when a documented name is valid in more than one context.
((identifier) @variable.special
  (#match? @variable.special "(?i)^(COL|CURACCEPT|CURBATCH|CURBEDROCK|CURCCLREV|CURCCLVER|CURCLIENTID|CURCLK|CURDATE|CURDOMAIN|CURECHO|CURENDREPORT|CURENV|CURGROUP|CURHELP|CURIMAGE|CURLOCALE|CURLOGDOMAIN|CURLOGDOMAINID|CURMAXVARLEN|CURMEM|CURNETDOMAIN|CURNETDOMAINID|CURNODE|CURPAGE|CURPRCNAME|CURPROG|CURQUAL|CURRDB|CURRDBACCESS|CURRDBHANDLE|CURRDBLINK|CURRDBNAME|CURRDBOPT|CURRDBSYS|CURRDBUSER|CURRDBVER|CURREF|CURRETURN|CURREV|CURREVHNAM|CURREVMINOR|CURREVMINOR2|CURSCROLL|CURSERVER|CURSOURCE|CURSUB|CURSYS|CURSYS2|CURSYSBIT|CURTIME|CURTIME2|CURTIME3|CURTIMEZONE|CURTIMEZONEAPP|CURTIMEZONEDEF|CURTIMEZONESYS|CURUSER|CURUTC|CURUTCDIFF|CURWORK|FALSE|MAXCOL|MAXROW|ROW|SYSDATE|SYSTIMESTAMP|TRUE)$"))
((boolean_literal) @variable.special
  (#match? @variable.special "(?i)^(FALSE|TRUE)$"))

